# ============================================================
# AgentsOffice 环境变量配置
# 复制此文件为 .env 并填入你的真实值
# .env 已加入 .gitignore，不会被提交到 git
# ============================================================

# ---------- 数据库 ----------
DATABASE_URL_SYNC=postgresql://ecom_dev:ecom_dev_pass@localhost:5432/ecom_ai_lab

# ---------- LLM API Keys（至少填一个） ----------
# Google Gemini
GEMINI_API_KEY=

# 阿里云百炼 DashScope（可选）
DASHSCOPE_API_KEY=

# OpenAI ChatGPT（可选）
OPENAI_API_KEY=

# DeepSeek（可选）
DEEPSEEK_API_KEY=

# Anthropic Claude（可选）
ANTHROPIC_API_KEY=

# ---------- Job API ----------
# JOB_API_KEY=                        # 鉴权暂未实现，后续迭代增加
JOB_DEFAULT_TIMEOUT=300               # 默认任务超时（秒）
JOB_CALLBACK_TIMEOUT=10               # 回调请求超时（秒）

# ---------- 文件存储 ----------
UPLOAD_DIR=uploads                    # 文件上传目录（Docker 中建议挂载 volume）
MAX_UPLOAD_SIZE_MB=50                 # 单文件上传大小限制（MB）
